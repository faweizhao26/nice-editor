{
  "name": "mdnice-clone",
  "version": "1.0.0",
  "private": true,
  "description": "复刻 Markdown Nice / mdnice 的核心编辑器：Markdown → 内联样式 HTML → 一键粘贴到公众号 / 知乎 / 掘金 / CSDN",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "gen:code-themes": "node scripts/gen-code-themes.mjs",
    "prepare:mathjax": "mkdir -p public/mathjax && cp node_modules/mathjax/tex-svg-nofont.js public/mathjax/tex-svg-nofont.js",
    "postinstall": "npm run prepare:mathjax"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@uiw/react-codemirror": "^4.25.12",
    "highlight.js": "^11.12.0",
    "juice": "^12.2.1",
    "lz-string": "^1.5.0",
    "markdown-it": "^15.0.3",
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-implicit-figures": "^0.12.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-ruby": "^1.1.2",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-table-of-contents": "^1.2.0",
    "markdown-it-task-lists": "^2.1.1",
    "mathjax": "^4.1.3",
    "next": "16.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/lz-string": "^1.3.34",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "typescript": "^5"
  }
}
